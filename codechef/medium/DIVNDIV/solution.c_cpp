#include <bits/stdc++.h>
using namespace std;

void solve(){
    long long x,y,z;
       cin>>x>>y>>z;
       
       if(y%z == 0){
           cout<<-1<<"\n";
           return;
       }
          long long k = (x/y + 1)*y;
       while(k%z == 0){
          k+=y;
          }cout<<k<<"\n";
}
int main() {
	// your code goes here
   int t;
   cin>>t;
   
   while(t--){
        solve();
       
    
   }return 0;
}
