#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
	long long n, m, c;
	cin>>n>>m>>c;
	
	vector<long long>a(n);
	for(int i=0; i<n; i++){
	    cin>>a[i];
	}
	vector<long long>b(m);
	for(int i=0; i<n; i++){
	    cin>>b[i];
	}
	
	for(int i=0; i<n; i++){
	    for(int j=0; j<m; j++){
	        if(a[i] +  b[j] == c){ cout<<"YES"<<"\n";
	            break;
	        }
	    }
	}cout<<"NO"<<"\n";
    return 0;
}
