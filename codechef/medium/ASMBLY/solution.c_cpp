#include <bits/stdc++.h>
using namespace std;

int main() {
	// your code goes here
    long long n;
    cin>>n;
    
    vector<long long>a(n);
    for(int i=0; i<n; i++){
        cin>>a[i];
    }
    
    long long cnt =0;
    int maxH = 0;
    
    for(int i=0; i<n; i++){
        if(a[i] > maxH){ 
            cnt++;
            maxH = a[i];
        }
    }
    cout<<cnt<<"\n";
    return 0;
}
